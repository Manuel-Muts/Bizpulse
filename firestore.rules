rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
    }

    function hasSchoolId() {
      return request.resource.data.schoolId is string && request.resource.data.schoolId.size() > 0;
    }

    function matchesSchoolPath(schoolId, resourceData) {
      return resourceData != null && resourceData.schoolId == schoolId;
    }

    function canReadSchoolData(schoolId) {
      return true;
    }

    function isActiveClient() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
    }

    function ownsDocument(resourceData) {
      return isActiveClient() && resourceData.uid == request.auth.uid;
    }

    function isValidFuelCostCategory(category) {
      return category in [
          'general',
          'petrol',
          'gas-cylinder',
          'k-gas',
          'total-gas',
          'pro-gas',
          'gas-refillable',
          'gas-nonrefillable',
          'soda-300ml',
          'soda-500ml',
          'medicine-purchase',
          'crate-item',
          'alcohol-crate-item',
          'accessory-item'
        ] ||
        (category is string &&
          (category.matches('^fuel:[A-Za-z0-9_-]{20}$') ||
           category.matches('^inventory-item:[A-Za-z0-9_-]{20}$')));
    }

    function hasValidInventoryItemExpense(data) {
      return !(data.costCategory is string &&
          data.costCategory.matches('^inventory-item:[A-Za-z0-9_-]{20}$')) ||
        (data.itemId is string &&
          data.itemId.size() == 20 &&
          data.costCategory == 'inventory-item:' + data.itemId &&
          data.itemName is string &&
          data.itemName.size() > 0 &&
          exists(/databases/$(database)/documents/items/$(data.itemId)) &&
          get(/databases/$(database)/documents/items/$(data.itemId)).data.uid == request.auth.uid &&
          get(/databases/$(database)/documents/items/$(data.itemId)).data.name == data.itemName);
    }

    function hasValidCrateExpenseItem(data) {
      return !(data.costCategory in ['crate-item', 'alcohol-crate-item']) ||
        (data.crateItemId is string &&
          data.crateItemId.size() > 0 &&
          data.crateItemName is string &&
          data.crateItemName.size() > 0);
    }

    function hasValidAccessoryExpenseItem(data) {
      return data.costCategory != 'accessory-item' ||
        (data.accessoryItemId is string &&
          data.accessoryItemId.size() > 0 &&
          data.accessoryItemName is string &&
          data.accessoryItemName.size() > 0);
    }

    function hasValidMedicinePurchaseExpense(data) {
      return data.costCategory != 'medicine-purchase' ||
        (data.purchaseBatchId is string && data.purchaseBatchId.size() > 0);
    }

    function hasValidMedicineBatch(data) {
      return data.itemId is string &&
        data.itemId.size() > 0 &&
        data.lotNumber is string &&
        data.lotNumber.size() > 0 &&
        data.expiryDate is string &&
        data.expiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.stockUnit is string &&
        data.stockUnit.size() > 0 &&
        data.receivedQuantity is number &&
        data.receivedQuantity > 0 &&
        data.remainingQuantity is number &&
        data.remainingQuantity >= 0 &&
        data.remainingQuantity <= data.receivedQuantity &&
        data.unitCost is number &&
        data.unitCost >= 0;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.firstLogin == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstLogin']));
    }

    match /items/{itemId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /sales/{saleId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /medicineBatches/{batchId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() ||
        (ownsDocument(request.resource.data) && hasValidMedicineBatch(request.resource.data));
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingQuantity']) &&
          request.resource.data.remainingQuantity is number &&
          request.resource.data.remainingQuantity >= 0 &&
          request.resource.data.remainingQuantity <= resource.data.receivedQuantity);
      allow delete: if isAdmin() ||
        (ownsDocument(resource.data) &&
          resource.data.remainingQuantity == resource.data.receivedQuantity);
    }

    match /stockAdditions/{additionId} {
      allow get: if isAdmin() ||
        (resource == null &&
          isActiveClient() &&
          additionId.matches('^' + request.auth.uid + '%7C.*$')) ||
        ownsDocument(resource.data);
      allow list: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'quantity',
            'quantityUnit',
            'stockDate',
            'piecesPerCrate',
            'unitsPerBox',
            'piecesAdded',
            'unitsAdded',
            'itemName',
            'movementId'
          ]));
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /stockMovements/{movementId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'itemName',
            'quantityDelta',
            'quantityUnit'
          ]));
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /customCrateTypes/{crateTypeId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /customBoxTypes/{boxTypeId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() ||
        (ownsDocument(request.resource.data) &&
          isValidFuelCostCategory(request.resource.data.costCategory) &&
          hasValidInventoryItemExpense(request.resource.data) &&
          hasValidCrateExpenseItem(request.resource.data) &&
          hasValidAccessoryExpenseItem(request.resource.data) &&
          hasValidMedicinePurchaseExpense(request.resource.data));
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'date',
            'type',
            'costCategory',
            'crateItemId',
            'crateItemName',
            'accessoryItemId',
            'accessoryItemName',
            'itemId',
            'itemName',
            'gasType',
            'description',
            'paidToSupplier',
            'vendor',
            'amount',
            'notes',
            'updatedAt'
          ]) &&
          isValidFuelCostCategory(request.resource.data.costCategory) &&
          hasValidInventoryItemExpense(request.resource.data) &&
          hasValidCrateExpenseItem(request.resource.data) &&
          hasValidAccessoryExpenseItem(request.resource.data) &&
          hasValidMedicinePurchaseExpense(request.resource.data));
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /fuelEnergyCategories/{categoryId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() ||
        (ownsDocument(request.resource.data) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 60);
      allow update, delete: if isAdmin();
    }

    match /accessoryItems/{accessoryId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() ||
        (ownsDocument(request.resource.data) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 60);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /booksStationeryItems/{itemId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() ||
        (ownsDocument(request.resource.data) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 60);
      allow update: if isAdmin() ||
        (ownsDocument(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin() || ownsDocument(resource.data);
    }

    match /salesSummaries/{userId} {
      allow read, create, update: if isAdmin() ||
        (isActiveClient() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || ownsDocument(resource.data);
      allow create: if isAdmin() || ownsDocument(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /news-posts/{postId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /alumni-registrations/{registrationId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /vacancies/{vacancyId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /documents/{documentId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /site-settings/{settingsId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }
    }
  }
}
